# Copy to .env and fill in. Leave WhatsApp values empty to run in mock mode (messages only saved locally).
NODE_ENV=development
PORT=8080
PUBLIC_URL=http://localhost:8080
# MENU_URL=https://order.yourrestaurant.ae/menu      # where the menu page (frontend) lives
# TRACK_URL=https://order.yourrestaurant.ae/track
CORS_ORIGIN=*
DB_FILE=data.db
APP_SECRET=change-me-long-random-string
STAFF_TOKEN=change-me-staff-password
MISSED_CALL_SECRET=

# WhatsApp Cloud API (Meta Business > WhatsApp > API setup)
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=pick-any-string
WA_UPDATE_TEMPLATE=        # approved utility template with one {{1}} body param
WA_TEMPLATE_LANG=en

# Optional: Supabase phone (OTP) login for customers who did not come through WhatsApp
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Restaurant
SHOP_NAME=Saffron & Salt
# Your WhatsApp number, digits only (shows a "Message us" button), e.g. 971501234567
SHOP_WHATSAPP=
SHOP_LAT=25.1852
SHOP_LNG=55.2721
DELIVERY_RADIUS_KM=5
DELIVERY_FEE_AED=0
MIN_ORDER_AED=0
OPEN_TIME=10:00
CLOSE_TIME=02:00
TRN=
PAYMENT_PROVIDER=mock
